AGATA_TIMEZONE=Europe/Moscow
AGATA_RELEASE_ID=template-v1

# Required only for the Telegram container or local polling.
AGATA_TELEGRAM_BOT_TOKEN=
# Required for a webhook. Generate a separate random value.
AGATA_TELEGRAM_WEBHOOK_SECRET=

# Optional settings for the generation job.
AGATA_GENERATOR=template
# AGATA_GENERATION_CONCURRENCY=4
# AGATA_MODEL_TIMEOUT=10

# gRPC model endpoint (hostname:port). TLS is on by default.
# AGATA_GENERATOR=grpc
# AGATA_MODEL_GRPC_TARGET=model.example.com:443
# AGATA_MODEL_ID=your-model-or-adapter
# AGATA_MODEL_API_KEY=

# HTTP compatibility for an existing OpenAI-compatible serving endpoint.
# AGATA_GENERATOR=openai_compatible
# AGATA_MODEL_ENDPOINT=https://example.com/v1/chat/completions
